# Copy to .env, chmod 600, and replace ALL secrets before starting.
APP_DOMAIN=http://localhost
APP_ORIGIN=http://localhost
API_ORIGIN=http://localhost
COOKIE_SECURE=false
NODE_ENV=development
REGISTRATION_ENABLED=false
PORT=3000
POSTGRES_USER=inferra
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://inferra:CHANGE_ME_LONG_RANDOM_SECRET@postgres:5432/inferra
AUTH_PEPPER=CHANGE_ME_RANDOM_64_HEX_BYTES_GENERATE_WITH_OPENSSL
VALKEY_URL=redis://valkey:6379
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
OTEL_SERVICE_NAME=inferra-api
VLLM_URL=http://vllm:8000
VLLM_API_KEY=CHANGE_ME_VLLM_PRIVATE_KEY
VLLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
VLLM_MAX_MODEL_LEN=4096
HF_TOKEN=
SMTP_URL=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_SECRET
RUSTFS_VERSION=latest
RUSTFS_ACCESS_KEY=CHANGE_ME_LONG_RANDOM_SECRET
RUSTFS_SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_BUCKET=inferra-artifacts
API_IMAGE=inferra/api:dev
WEB_IMAGE=inferra/web:dev

# Optional on-prem controls (not externally billed cloud services)
GPU_HOURLY_RATE_USD=0
DCGM_METRICS_URL=http://dcgm-exporter:9400/metrics
# Comma-separated exact HTTPS hostnames authorized for outbound webhooks. Empty disables webhooks.
WEBHOOK_ALLOWED_HOSTS=
# RESTIC_REPOSITORY and RESTIC_PASSWORD_FILE are host operator settings (not passed into containers).
