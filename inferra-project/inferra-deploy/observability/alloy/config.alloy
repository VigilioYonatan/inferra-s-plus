// Local Docker log tailing (private Compose network; no cloud logging).
local.file_match "docker_json" {
  path_targets = [{__path__ = "/var/lib/docker/containers/*/*-json.log", job = "inferra-docker"}]
  sync_period = "30s"
}
loki.source.file "docker" {
  targets = local.file_match.docker_json.targets
  forward_to = [loki.write.private.receiver]
}
loki.write "private" {
  endpoint {url = "http://loki:3100/loki/api/v1/push"}
}
