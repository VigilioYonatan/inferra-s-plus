{
  "title": "Inferra — Inference SLO",
  "uid": "inferra-slo",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Inference RPS",
      "id": 1,
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(inferra_inference_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "p95 Latency",
      "id": 2,
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by(le)(rate(inferra_inference_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active streams",
      "id": 3,
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(inferra_inference_active)",
          "refId": "A"
        }
      ]
    }
  ]
}
